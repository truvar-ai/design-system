{
  "color": {
    "brand": {
      "$description": "EasySocials brand colours. Primary: the logo gradient #22C55E → #20E261 → #0ABB45. Secondary: #FCB517. They fill the same slots as Truvar's raw colours, so every component that uses navy, gold or bronze picks them up.",
      "navy-900": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0784,
            0.3255,
            0.1765
          ],
          "hex": "#14532d"
        },
        "$description": "EasySocials Forest: the anchor slot (Truvar navy). Hero fields, filled marks, tooltips."
      },
      "gold-300": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.9882,
            0.7098,
            0.0902
          ],
          "hex": "#fcb517"
        },
        "$description": "EasySocials Yellow #FCB517, the secondary colour. The highlight slot (Truvar gold): fills and text on forest and dark grounds; never text on white."
      },
      "bronze-700": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.898,
            0.6275,
            0.051
          ],
          "hex": "#e5a00d"
        },
        "$description": "Deeper yellow for small marks on light grounds (the assistant mark's second dots). Not for text."
      },
      "green-500": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.1333,
            0.7725,
            0.3686
          ],
          "hex": "#22c55e"
        },
        "$description": "EasySocials Green #22C55E, the start of the logo gradient. Decoration on light grounds; text and fills on dark ones."
      },
      "green-700": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0824,
            0.502,
            0.2392
          ],
          "hex": "#15803d"
        },
        "$description": "The brand green deepened until white text on it, and it as text on white, reach 5:1. Primary actions, links and the selected state on light grounds."
      },
      "green-400": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.1255,
            0.8863,
            0.3804
          ],
          "hex": "#20e261"
        },
        "$description": "Middle of the logo gradient. Decoration only."
      },
      "green-600": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0392,
            0.7333,
            0.2706
          ],
          "hex": "#0abb45"
        },
        "$description": "End of the logo gradient. Decoration only."
      }
    },
